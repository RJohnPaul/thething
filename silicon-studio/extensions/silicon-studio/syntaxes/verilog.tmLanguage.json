{
  "name": "Verilog",
  "scopeName": "source.verilog",
  "fileTypes": ["v", "vh", "vl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#attributes" },
    { "include": "#directives" },
    { "include": "#module-declaration" },
    { "include": "#subroutine-declaration" },
    { "include": "#keywords" },
    { "include": "#instantiation" },
    { "include": "#system-tasks" },
    { "include": "#numbers" },
    { "include": "#escaped-identifier" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.verilog",
          "match": "(//).*$",
          "captures": { "1": { "name": "punctuation.definition.comment.verilog" } }
        },
        {
          "name": "comment.block.verilog",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": { "0": { "name": "punctuation.definition.comment.verilog" } }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.verilog",
      "begin": "\"",
      "end": "\"|(?<!\\\\)$",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.verilog" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.verilog" } },
      "patterns": [
        { "name": "constant.character.escape.verilog", "match": "\\\\(?:[0-7]{1,3}|x[0-9a-fA-F]{1,2}|.|$)" },
        { "name": "constant.other.placeholder.verilog", "match": "%(?:[-0]?\\d*(?:\\.\\d+)?)?[bBoOdDhHxXeEfFgGtTsScCmMlLvVuUzZpP%]" }
      ]
    },
    "attributes": {
      "name": "meta.attribute.verilog",
      "begin": "\\(\\*(?!\\s*\\))",
      "end": "\\*\\)",
      "captures": { "0": { "name": "punctuation.definition.attribute.verilog" } },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "name": "entity.other.attribute-name.verilog", "match": "[a-zA-Z_][\\w$]*" }
      ]
    },
    "directives": {
      "patterns": [
        {
          "match": "(`(?:define|ifdef|ifndef|elsif|undef))\\s+([a-zA-Z_][\\w$]*)",
          "captures": {
            "1": { "name": "keyword.other.preprocessor.verilog" },
            "2": { "name": "entity.name.function.preprocessor.verilog" }
          }
        },
        {
          "name": "keyword.other.preprocessor.verilog",
          "match": "`(?:define|undef|undefineall|ifdef|ifndef|elsif|else|endif|include|timescale|default_nettype|resetall|celldefine|endcelldefine|unconnected_drive|nounconnected_drive|line|pragma|begin_keywords|end_keywords|default_decay_time|default_trireg_strength|delay_mode_distributed|delay_mode_path|delay_mode_unit|delay_mode_zero|__FILE__|__LINE__)\\b"
        },
        { "name": "entity.name.function.preprocessor.verilog", "match": "`[a-zA-Z_][\\w$]*" }
      ]
    },
    "module-declaration": {
      "match": "\\b(module|macromodule|primitive|config)\\s+(?:(automatic|static)\\s+)?([a-zA-Z_][\\w$]*|\\\\\\S+)",
      "captures": {
        "1": { "name": "storage.type.declaration.verilog" },
        "2": { "name": "storage.modifier.verilog" },
        "3": { "name": "entity.name.type.module.verilog" }
      }
    },
    "subroutine-declaration": {
      "comment": "function/task <lifetime/return type...> name ( or ;  -- the middle part is re-tokenized with the base grammar",
      "match": "\\b(function|task)\\b([^;(]*?)\\b([a-zA-Z_][\\w$]*)\\s*(?=[(;])",
      "captures": {
        "1": { "name": "storage.type.declaration.verilog" },
        "2": { "patterns": [{ "include": "$base" }] },
        "3": { "name": "entity.name.function.verilog" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.verilog",
          "match": "\\b(?:if|else|case|casex|casez|endcase|default|for|forever|repeat|while|wait|disable|fork|join|begin|end|ifnone)\\b"
        },
        {
          "name": "storage.type.declaration.verilog",
          "match": "\\b(?:module|macromodule|endmodule|primitive|endprimitive|function|endfunction|task|endtask|config|endconfig|parameter|localparam|specparam)\\b"
        },
        {
          "name": "storage.type.verilog",
          "match": "\\b(?:wire|reg|integer|real|realtime|time|event|genvar|tri|tri0|tri1|triand|trior|trireg|wand|wor|uwire|supply0|supply1)\\b"
        },
        {
          "name": "storage.modifier.verilog",
          "match": "\\b(?:input|output|inout|signed|unsigned|automatic|scalared|vectored|small|medium|large|strong0|strong1|pull0|pull1|weak0|weak1|highz0|highz1)\\b"
        },
        {
          "name": "keyword.other.verilog",
          "match": "\\b(?:always|initial|assign|deassign|force|release|posedge|negedge|edge|generate|endgenerate|specify|endspecify|table|endtable|defparam|design|instance|cell|use|liblist|library|incdir|include|pulsestyle_ondetect|pulsestyle_onevent|showcancelled|noshowcancelled)\\b"
        },
        { "name": "keyword.operator.word.verilog", "match": "\\bor\\b" },
        {
          "name": "support.type.gate.verilog",
          "match": "\\b(?:and|nand|nor|xor|xnor|buf|not|bufif0|bufif1|notif0|notif1|cmos|rcmos|nmos|pmos|rnmos|rpmos|tran|tranif0|tranif1|rtran|rtranif0|rtranif1|pullup|pulldown)\\b"
        }
      ]
    },
    "instantiation": {
      "comment": "Relies on keyword rules being listed earlier so 'else if (' etc. never reach here.",
      "patterns": [
        {
          "name": "meta.instantiation.verilog",
          "begin": "(?<![\\w$.`'\\\\])([a-zA-Z_][\\w$]*)\\s*(?=#\\s*\\()",
          "beginCaptures": { "1": { "name": "entity.name.type.module.verilog" } },
          "end": "(?<=\\))\\s*([a-zA-Z_][\\w$]*)(?=\\s*[(\\[])|(?=;)",
          "endCaptures": { "1": { "name": "entity.name.variable.instance.verilog" } },
          "patterns": [{ "include": "$base" }]
        },
        {
          "match": "(?<![\\w$.`'\\\\])([a-zA-Z_][\\w$]*)\\s+([a-zA-Z_][\\w$]*)(?=\\s*(?:\\[[^\\]]*\\]\\s*)?\\()",
          "captures": {
            "1": { "name": "entity.name.type.module.verilog" },
            "2": { "name": "entity.name.variable.instance.verilog" }
          }
        }
      ]
    },
    "system-tasks": {
      "name": "support.function.system.verilog",
      "match": "(?<![\\w$])\\$[a-zA-Z_][\\w$]*"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.time.verilog", "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:fs|ps|ns|us|ms|s|step)\\b" },
        { "name": "constant.numeric.real.verilog", "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?|[eE][+-]?\\d[\\d_]*)\\b" },
        {
          "name": "constant.numeric.verilog",
          "match": "(?:\\b\\d[\\d_]*\\s*)?'[sS]?(?:[bB]\\s*[01xXzZ?_]+|[oO]\\s*[0-7xXzZ?_]+|[dD]\\s*[0-9xXzZ?_]+|[hH]\\s*[0-9a-fA-FxXzZ?_]+)"
        },
        { "name": "constant.numeric.verilog", "match": "'[01xXzZ](?![\\w$])" },
        { "name": "constant.numeric.verilog", "match": "\\b\\d[\\d_]*\\b" }
      ]
    },
    "escaped-identifier": {
      "name": "variable.other.escaped.verilog",
      "match": "(?<![\\w$])\\\\\\S+"
    },
    "operators": {
      "name": "keyword.operator.verilog",
      "match": "===|!==|==\\?|!=\\?|<->|\\|->|\\|=>|->>|<<<=|>>>=|<<<|>>>|<<=|>>=|<<|>>|==|!=|<=|>=|&&|\\|\\||\\*\\*|->|\\+\\+|--|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|~&|~\\||~\\^|\\^~|::|:=|:/|##|[-+*/%<>!~&|^?:=@#']"
    }
  }
}
